# Supabase (public / anon only — never put service role key in frontend)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key

# Optional: used only by local seed scripts (scripts/seed-supabase.mjs)
# Keep this in .env.local and never commit it.
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Existing map keys (unchanged)
# NEXT_PUBLIC_AMAP_KEY=
# NEXT_PUBLIC_AMAP_SECURITY_CODE=
